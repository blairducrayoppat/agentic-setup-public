<?xml version="1.0" encoding="utf-8"?>
<!--
  Deterministic, network-independent NuGet configuration for the staged WinUI
  build infrastructure.

  <clear/> drops every inherited package source (machine-wide nuget.org, any
  user-level feeds) so a restore here is reproducible and offline: the ONLY
  source is the local mirror at C:\Users\mrbla\blarai-build\nuget-feed, which
  ../mirror-feed.ps1 populates from the global cache.

  Because NuGet walks UP the directory tree for nuget.config, the reference/
  template one level below inherits this file — so `dotnet restore` /
  `dotnet build` in reference/ resolves the pinned WinUI closure straight from
  the offline feed with no network access.

  NOTE: the feed is a FLAT folder of .nupkg files (a v2 local source), which is
  exactly what a "dotnet restore" source flag and a packageSources entry both
  consume. No feed indexing step is required.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="blarai-local-winui" value="C:\Users\mrbla\blarai-build\nuget-feed" />
  </packageSources>
</configuration>
