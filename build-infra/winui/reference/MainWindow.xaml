<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MinimalWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MinimalWinUI">

    <!--
        NAMED HOOKS for the staged coder prompt. This shell already wires the core
        (a Calculator instance in the code-behind drives the Display below), so the
        coder's step-2 job is to THEME and EXTEND this layout (colours, fonts, a
        full button grid, the rocket shape), NOT to re-author the wiring. Keep the
        x:Name="Display" (the code-behind references it) and build the UI around it.
    -->
    <StackPanel
        x:Name="RootPanel"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
        <!-- The result/readout. The code-behind writes Calculator output here. -->
        <TextBlock
            x:Name="Display"
            Text="0"
            Style="{StaticResource TitleTextBlockStyle}"
            HorizontalAlignment="Center" />
        <!-- A seed button proving the XAML compiler + code-behind + event wiring all
             link, AND that the Calculator core reaches the Display. The coder
             replaces this with the real number and operator buttons, routing each
             through the Calculator core (see MainWindow.xaml.cs). -->
        <Button
            x:Name="DemoButton"
            Content="2 + 3"
            HorizontalAlignment="Center"
            Click="DemoButton_Click" />
    </StackPanel>
</Window>
