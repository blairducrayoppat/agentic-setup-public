  "mcp": {
    "browser": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "playwright-mcp",
        "--browser",
        "msedge",
        "--headless",
        "--isolated",
        "--allow-unrestricted-file-access"
      ],
      "enabled": true
    }
  },
  "tools": {
    "websearch": false,
    "webfetch": false,
    "skill": false
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 32768
  },
  "agent": {
    "build": {
      "temperature": 0.7,
      "top_p": 0.8
    },
    "plan": {
      "temperature": 0.7,
      "top_p": 0.8
    }
  }
