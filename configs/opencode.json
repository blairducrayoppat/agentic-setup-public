{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local OVMS (Arc 140V)",
      "options": {
        "baseURL": "http://127.0.0.1:8099/v3",
        "apiKey": "local"
      },
      "models": {
        "coder-30b": {
          "name": "Qwen3-Coder-30B-A3B INT4 — power tier (lean profile!)",
          "tool_call": true,
          "reasoning": false,
          "temperature": true,
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "qwen3-14b": {
          "name": "Qwen3-14B INT4 — everyday/fleet tier",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3-vl-8b": {
          "name": "Qwen3-VL-8B INT4 — vision/screenshots",
          "tool_call": false,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ]
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "local/qwen3-14b",
  "snapshot": false,
  "experimental": {
    "continue_loop_on_deny": true
  },
